# Shab public API host (no trailing slash)
SHAB_API_BASE_URL=https://api.shab.ir
SHAB_API_LANG=fa
SHAB_API_VERSION=v_1_4

# HTTP client
SHAB_CONNECT_TIMEOUT=5.0
SHAB_READ_TIMEOUT=20.0
SHAB_MAX_RETRIES=2

# MCP server (HTTP mode for Docker / LiteLLM)
SHAB_MCP_HOST=0.0.0.0
SHAB_MCP_PORT=8000
SHAB_MCP_TRANSPORT=http

# Non-stateful Origin so OTP verify returns access_token (not SPA cookie session)
SHAB_API_ORIGIN=https://mcp.shab.systems
SHAB_API_PLATFORM=mcp
SHAB_WEB_BASE_URL=https://www.shab.ir
